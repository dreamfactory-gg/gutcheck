#!/bin/sh
# Print the Python gutcheck should run with: the managed venv when present, else the first Python 3.12+ on PATH.
# Exits 1 (printing nothing) when there is none. Sourced logic for the gutcheck shims and setup.sh.
home="${GUTCHECK_HOME:-$HOME/.local/share/gutcheck}"
if [ "${1:-}" != "--system" ] && [ -x "$home/venv/bin/python" ]; then
  echo "$home/venv/bin/python"; exit 0
fi
for c in python3.14 python3.13 python3.12 python3; do
  p=$(command -v "$c" 2>/dev/null) || continue
  "$p" -c 'import sys; sys.exit(sys.version_info < (3, 12))' 2>/dev/null && { echo "$p"; exit 0; }
done
exit 1
