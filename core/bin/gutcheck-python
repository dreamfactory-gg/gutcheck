#!/bin/sh
# Print the Python the plugins run with: the managed venv when present, else the first Python 3.12+ on PATH.
# Exits 1 (printing nothing) when there is none. Used by the gutcheck and tokenmaxxing shims and setup.sh.
home="${GUTCHECK_HOME:-$HOME/.local/share/gutcheck}"
if [ "$OS" = Windows_NT ]; then py="$home/venv/Scripts/python.exe"; else py="$home/venv/bin/python"; fi
if [ "${1:-}" != "--system" ] && [ -x "$py" ]; then
  echo "$py"; exit 0
fi
for c in python3.14 python3.13 python3.12 python3; do
  p=$(command -v "$c" 2>/dev/null) || continue
  "$p" -c 'import sys; sys.exit(sys.version_info < (3, 12))' 2>/dev/null && { echo "$p"; exit 0; }
done
if [ "$OS" = Windows_NT ]; then
  PYTHONUTF8=1 py -3 -c 'import sys; sys.exit(1) if sys.version_info < (3, 12) else sys.stdout.write(sys.executable)' 2>/dev/null && exit 0
fi
exit 1
